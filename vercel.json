{
    "headers": [
        {
            "source": "/assets/([^/]+-[A-Za-z0-9_-]{8}\\.[A-Za-z0-9]+)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "moonmoon-gacha.vercel.app"
                }
            ],
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        }
    ]
}
